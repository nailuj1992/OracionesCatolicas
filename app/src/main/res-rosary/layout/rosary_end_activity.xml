<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.prayers.app.activity.rosary.RosaryEndActivity">

    <ScrollView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/nav_buttons"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:paddingTop="@dimen/margin_30">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_20"
            android:layout_marginRight="@dimen/margin_20"
            android:paddingTop="@dimen/margin_20"
            android:paddingBottom="@dimen/margin_20">

            <TextView
                android:id="@+id/title_sign_cross"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:gravity="center_horizontal"
                android:paddingTop="@dimen/margin_5"
                android:paddingBottom="@dimen/margin_50"
                android:text="@string/title_sign_cross"
                android:textAlignment="center"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_30" />

            <TextView
                android:id="@+id/txt_sign_cross"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/title_sign_cross"
                android:paddingTop="@dimen/margin_80"
                android:paddingBottom="@dimen/margin_25"
                android:text="@string/txt_sign_cross_2"
                android:textSize="@dimen/text_size_20" />

            <TextView
                android:id="@+id/lbl_amen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_sign_cross"
                android:layout_alignParentEnd="true"
                android:paddingTop="@dimen/margin_100"
                android:paddingBottom="@dimen/margin_25"
                android:text="@string/txt_amen"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_30" />
        </RelativeLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/rosary_mysteries_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:alpha="0.2"
        android:paddingTop="@dimen/margin_50"
        app:srcCompat="@mipmap/lights_wrath_2_vert" />

    <include layout="@layout/include_btn_home" />

    <include layout="@layout/include_nav_buttons_end" />
</RelativeLayout>