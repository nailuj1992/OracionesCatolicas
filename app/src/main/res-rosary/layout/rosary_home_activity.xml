<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.prayers.app.activity.rosary.RosaryHomeActivity">

    <TextView
        android:id="@+id/title_rosary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/margin_left"
        android:layout_marginEnd="@dimen/margin_right"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/margin_top"
        android:text="@string/title_rosary"
        android:textAlignment="center"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/text_size_30" />

    <ScrollView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/nav_buttons"
        android:layout_below="@+id/title_rosary"
        android:layout_alignParentStart="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_20"
            android:layout_marginRight="@dimen/margin_20"
            android:paddingTop="@dimen/margin_40"
            android:paddingBottom="@dimen/margin_40">

            <RadioGroup
                android:id="@+id/radio_mysteries"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/txt_rosary_choose_mystery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/margin_45"
                    android:text="@string/txt_rosary_choose_mystery"
                    android:textAlignment="center"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_22" />

                <RadioButton
                    android:id="@+id/radio_joyful"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_10"
                    android:text="@string/title_rosary_joyful_with_days"
                    android:textSize="@dimen/text_size_15" />

                <RadioButton
                    android:id="@+id/radio_sorrowful"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_20"
                    android:text="@string/title_rosary_sorrowful_with_days"
                    android:textSize="@dimen/text_size_15" />

                <RadioButton
                    android:id="@+id/radio_glorious"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_20"
                    android:text="@string/title_rosary_glorious_with_days"
                    android:textSize="@dimen/text_size_15" />

                <RadioButton
                    android:id="@+id/radio_luminous"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_20"
                    android:text="@string/title_rosary_luminous_with_days"
                    android:textSize="@dimen/text_size_15" />

                <TextView
                    android:id="@+id/txt_rosary_auto_mystery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/margin_100"
                    android:text="@string/txt_rosary_auto_mystery"
                    android:textAlignment="center"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_18" />
            </RadioGroup>
        </RelativeLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/rosary_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:alpha="0.2"
        android:paddingTop="@dimen/margin_50"
        app:srcCompat="@mipmap/lights_wrath_2_vert" />

    <include layout="@layout/include_btn_home" />

    <include layout="@layout/include_nav_buttons_begin" />
</RelativeLayout>
